{
  "type": "module",
  "name": "@rvoh/psychic-workers",
  "description": "Background job system for Psychic applications",
  "version": "2.8.0",
  "author": "RVO Health",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rvohealth/psychic-workers.git"
  },
  "license": "MIT",
  "main": "./dist/cjs/src/package-exports/index.js",
  "module": "./dist/esm/src/package-exports/index.js",
  "types": "./dist/types/src/package-exports/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/src/package-exports/index.d.ts",
      "import": "./dist/esm/src/package-exports/index.js",
      "require": "./dist/cjs/src/package-exports/index.js"
    },
    "./errors": {
      "types": "./dist/types/src/package-exports/errors.d.ts",
      "import": "./dist/esm/src/package-exports/errors.js",
      "require": "./dist/cjs/src/package-exports/errors.js"
    },
    "./types": {
      "types": "./dist/types/src/package-exports/types.d.ts",
      "import": "./dist/esm/src/package-exports/types.js",
      "require": "./dist/cjs/src/package-exports/types.js"
    },
    "./utils": {
      "types": "./dist/types/src/package-exports/utils.d.ts",
      "import": "./dist/esm/src/package-exports/utils.js",
      "require": "./dist/cjs/src/package-exports/utils.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "psy": "NODE_ENV=${NODE_ENV:-test} pnpm psy:ts",
    "psy:js": "node ./dist/test-app/src/cli/index.js",
    "psy:ts": "tsx ./test-app/src/cli/index.ts",
    "build": "echo \"building cjs...\" && rm -rf dist && tsc -p ./tsconfig.cjs.build.json && echo \"building esm...\" && tsc -p ./tsconfig.esm.build.json",
    "build:test-app": "rm -rf dist && echo \"building test app to esm...\" && tsc -p ./tsconfig.esm.build.test-app.json && echo \"building test app to cjs...\" && tsc -p ./tsconfig.cjs.build.test-app.json",
    "uspec": "vitest --config ./spec/unit/vite.config.ts",
    "format": "pnpm prettier . --write",
    "lint": "pnpm eslint --no-warn-ignored \"src/**/*.ts\" \"spec/**/*.ts\" \"test-app/**/*.ts\" && pnpm prettier . --check",
    "console": "tsx ./src/conf/repl.ts",
    "console:js": "node ./dist/src/conf/repl.js",
    "prepack": "pnpm build",
    "dev-worker": "NODE_ENV=development WORKER_COUNT=1 tsx ./test-app/worker.ts"
  },
  "peerDependencies": {
    "@rvoh/dream": ">=2.0.0",
    "@rvoh/psychic": ">=2.0.0",
    "bullmq": "^5.64.0",
    "ioredis": "^5.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@koa/cors": "^5.0.0",
    "@koa/etag": "^5.0.2",
    "@koa/router": "^15.7.0",
    "@rvoh/dream": "^2.35.0",
    "@rvoh/dream-spec-helpers": "^2.4.0",
    "@rvoh/psychic": "^3.15.3",
    "@rvoh/psychic-spec-helpers": "^3.4.1",
    "@types/koa": "^3.0.3",
    "@types/koa-bodyparser": "^4.3.13",
    "@types/koa-conditional-get": "^2.0.4",
    "@types/koa-etag": "^3.0.4",
    "@types/koa__cors": "^5.0.1",
    "@types/koa__router": "^12.0.5",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/parser": "^8.71.0",
    "bullmq": "^5.81.5",
    "eslint": "^10.12.0",
    "ioredis": "^5.11.1",
    "koa": "^3.2.1",
    "koa-bodyparser": "^4.4.1",
    "koa-conditional-get": "^3.0.0",
    "kysely": "^0.29.6",
    "kysely-codegen": "~0.20.0",
    "luxon-jest-matchers": "^0.1.14",
    "openapi-typescript": "^7.13.0",
    "pg": "^8.23.1",
    "prettier": "^3.9.9",
    "puppeteer": "^25.12.0",
    "supertest": "^7.3.1",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.9.0+sha512.bd682d5d03fe525ef7c9fd6780c6884d1e756ac4c9c9fe00c538782824310dcf90e3ddc4f53835f06dfaebd5085e41855e0bcbb3b60de2ac5bbab89e5036f03b",
  "dependencies": {
    "commander": "^14.0.3",
    "dotenv": "^17.4.2",
    "pluralize-esm": "^9.0.5"
  }
}
